  <!-- Inline fail-safe: guarantees preloader dismisses within 1.2s max on all devices -->
  <script>
    (function(){
      var p = document.getElementById('preloader');
      if (!p) return;
      var dismiss = function() {
        if (!p || p.classList.contains('done')) return;
        p.classList.add('done');
        setTimeout(function(){ if(p && p.parentNode) p.parentNode.removeChild(p); }, 600);
      };
      if (document.readyState === 'complete') { setTimeout(dismiss, 400); }
      else { window.addEventListener('load', function(){ setTimeout(dismiss, 500); }); }
      setTimeout(dismiss, 1200);
    })();
